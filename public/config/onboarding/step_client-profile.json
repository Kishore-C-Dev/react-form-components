{
  "stepId": "client-profile",
  "title": "Client Profile",
  "sections": [
    {
      "title": "Legal Entity Information",
      "columns": 2,
      "fields": [
        {
          "name": "legalEntityName",
          "label": "Legal Entity Name",
          "type": "text",
          "placeholder": "Full registered legal name",
          "validations": {
            "minLength": {
              "value": 3,
              "message": "Minimum 3 characters"
            },
            "maxLength": {
              "value": 150,
              "message": "Maximum 150 characters"
            }
          }
        },
        {
          "name": "entityType",
          "label": "Entity Type",
          "type": "select",
          "placeholder": "Select entity type",
          "options": [
            {
              "label": "Corporation / Ltd",
              "value": "corporation"
            },
            {
              "label": "Limited Liability Company (LLC)",
              "value": "llc"
            },
            {
              "label": "Partnership",
              "value": "partnership"
            },
            {
              "label": "Limited Partnership (LP)",
              "value": "lp"
            },
            {
              "label": "Sole Proprietorship",
              "value": "sole_prop"
            },
            {
              "label": "Non-Profit Organization",
              "value": "non_profit"
            },
            {
              "label": "Government / State-Owned Entity",
              "value": "government"
            },
            {
              "label": "Trust",
              "value": "trust"
            }
          ]
        },
        {
          "name": "countryOfIncorporation",
          "label": "Country of Incorporation",
          "type": "select",
          "placeholder": "Select country\u2026",
          "dataSource": "/api/ref/countries"
        },
        {
          "name": "dateOfIncorporation",
          "label": "Date of Incorporation",
          "type": "date"
        },
        {
          "name": "registrationNumber",
          "label": "Company Registration Number",
          "type": "text",
          "placeholder": "e.g. 12345678"
        },
        {
          "name": "taxId",
          "label": "Tax ID / EIN",
          "type": "text",
          "placeholder": "e.g. 12-3456789",
          "hint": "Tax identification number in country of incorporation"
        },
        {
          "name": "lei",
          "label": "LEI (Legal Entity Identifier)",
          "type": "text",
          "placeholder": "20-character alphanumeric code",
          "hint": "Required for entities subject to MiFID II / EMIR reporting",
          "validations": {
            "pattern": {
              "value": "^[A-Z0-9]{20}$",
              "message": "LEI must be exactly 20 alphanumeric characters"
            }
          }
        },
        {
          "name": "industrySector",
          "label": "Industry / Sector",
          "type": "select",
          "placeholder": "Select industry",
          "options": [
            {
              "label": "Manufacturing",
              "value": "manufacturing"
            },
            {
              "label": "Real Estate & Construction",
              "value": "real_estate"
            },
            {
              "label": "Financial Services",
              "value": "financial_services"
            },
            {
              "label": "Technology & IT",
              "value": "technology"
            },
            {
              "label": "Healthcare & Pharmaceuticals",
              "value": "healthcare"
            },
            {
              "label": "Energy & Natural Resources",
              "value": "energy"
            },
            {
              "label": "Trading & Import/Export",
              "value": "trading"
            },
            {
              "label": "Retail & Consumer Goods",
              "value": "retail"
            },
            {
              "label": "Professional Services",
              "value": "professional_services"
            },
            {
              "label": "Transportation & Logistics",
              "value": "logistics"
            },
            {
              "label": "Education",
              "value": "education"
            },
            {
              "label": "Non-Government Organization",
              "value": "ngo"
            },
            {
              "label": "Other",
              "value": "other"
            }
          ]
        }
      ]
    },
    {
      "title": "Registered Address",
      "columns": 2,
      "fields": [
        {
          "name": "regAddressLine1",
          "label": "Address Line 1",
          "type": "text",
          "placeholder": "Street address, P.O. Box"
        },
        {
          "name": "regAddressLine2",
          "label": "Address Line 2 (Optional)",
          "type": "text",
          "placeholder": "Suite, unit, floor"
        },
        {
          "name": "regCity",
          "label": "City",
          "type": "text",
          "placeholder": "City"
        },
        {
          "name": "regState",
          "label": "State / Province",
          "type": "text",
          "placeholder": "State or Province"
        },
        {
          "name": "regPostalCode",
          "label": "Postal Code",
          "type": "text",
          "placeholder": "Postal / ZIP code"
        },
        {
          "name": "regCountry",
          "label": "Country",
          "type": "select",
          "placeholder": "Select country\u2026",
          "dataSource": "/api/ref/countries"
        }
      ]
    },
    {
      "title": "Primary Contact",
      "columns": 2,
      "fields": [
        {
          "name": "contactName",
          "label": "Contact Person Name",
          "type": "text",
          "placeholder": "Full name"
        },
        {
          "name": "contactDesignation",
          "label": "Title / Designation",
          "type": "text",
          "placeholder": "e.g. CFO, Treasurer, Director"
        },
        {
          "name": "contactEmail",
          "label": "Email Address",
          "type": "email",
          "placeholder": "contact@company.com",
          "validations": {
            "pattern": {
              "value": "^[\\w.\\-]+@[\\w.\\-]+\\.[a-zA-Z]{2,}$",
              "message": "Invalid email address"
            }
          }
        },
        {
          "name": "contactPhone",
          "label": "Phone Number",
          "type": "tel",
          "placeholder": "+1 (555) 123-4567"
        },
        {
          "name": "website",
          "label": "Company Website",
          "type": "url",
          "placeholder": "https://www.company.com"
        },
        {
          "name": "annualRevenueUsd",
          "label": "Annual Revenue (USD)",
          "type": "select",
          "placeholder": "Select range",
          "options": [
            {
              "label": "< $1 Million",
              "value": "lt_1m"
            },
            {
              "label": "$1M \u2013 $10M",
              "value": "1m_10m"
            },
            {
              "label": "$10M \u2013 $50M",
              "value": "10m_50m"
            },
            {
              "label": "$50M \u2013 $250M",
              "value": "50m_250m"
            },
            {
              "label": "$250M \u2013 $1 Billion",
              "value": "250m_1b"
            },
            {
              "label": "> $1 Billion",
              "value": "gt_1b"
            }
          ]
        }
      ]
    }
  ]
}
