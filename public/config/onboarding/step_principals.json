{
  "stepId": "principals",
  "title": "Principal Officers",
  "sections": [
    {
      "title": "Authorized Signatories / Directors",
      "columns": 1,
      "fields": [
        {
          "name": "signatories",
          "label": "Authorized Signatories / Directors",
          "type": "repeatable-group",
          "fullWidth": true,
          "maxRecords": 3,
          "tableColumns": [
            {
              "label": "Full Name",
              "field": "name"
            },
            {
              "label": "Designation",
              "field": "designation"
            },
            {
              "label": "Nationality",
              "field": "nationality"
            },
            {
              "label": "ID Type",
              "field": "idType"
            },
            {
              "label": "PEP",
              "field": "isPep"
            }
          ],
          "groupFields": [
            {
              "name": "name",
              "label": "Full Name",
              "type": "text",
              "placeholder": "Legal full name as on ID document",
              "fullWidth": true,
              "validations": {
                "required": {
                  "value": true,
                  "message": "Full name is required"
                }
              }
            },
            {
              "name": "designation",
              "label": "Designation / Title",
              "type": "select",
              "placeholder": "Select designation",
              "options": [
                {
                  "label": "Chief Executive Officer (CEO)",
                  "value": "ceo"
                },
                {
                  "label": "Chief Financial Officer (CFO)",
                  "value": "cfo"
                },
                {
                  "label": "Managing Director",
                  "value": "md"
                },
                {
                  "label": "Director",
                  "value": "director"
                },
                {
                  "label": "Authorized Signatory",
                  "value": "auth_signatory"
                },
                {
                  "label": "Managing Partner",
                  "value": "managing_partner"
                },
                {
                  "label": "Trustee",
                  "value": "trustee"
                },
                {
                  "label": "Company Secretary",
                  "value": "company_secretary"
                }
              ]
            },
            {
              "name": "nationality",
              "label": "Nationality",
              "type": "select",
              "dataSource": "/api/ref/nationalities",
              "placeholder": "Select nationality\u2026"
            },
            {
              "name": "dob",
              "label": "Date of Birth",
              "type": "date"
            },
            {
              "name": "idType",
              "label": "ID Document Type",
              "type": "select",
              "placeholder": "Select ID type",
              "options": [
                {
                  "label": "Passport",
                  "value": "passport"
                },
                {
                  "label": "National Identity Card",
                  "value": "national_id"
                },
                {
                  "label": "Driver's License",
                  "value": "drivers_license"
                },
                {
                  "label": "Resident Permit",
                  "value": "resident_permit"
                }
              ]
            },
            {
              "name": "idNumber",
              "label": "ID / Passport Number",
              "type": "text",
              "placeholder": "e.g. AB1234567",
              "validations": {
                "required": {
                  "value": true,
                  "message": "ID number is required"
                }
              }
            },
            {
              "name": "idExpiry",
              "label": "ID Expiry Date",
              "type": "date"
            },
            {
              "name": "countryOfResidence",
              "label": "Country of Residence",
              "type": "select",
              "dataSource": "/api/ref/countries",
              "placeholder": "Select country\u2026"
            },
            {
              "name": "isPep",
              "label": "Politically Exposed Person (PEP)?",
              "type": "radio",
              "options": [
                {
                  "label": "Yes",
                  "value": "yes"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ]
            },
            {
              "name": "pepDetails",
              "label": "PEP Details",
              "type": "textarea",
              "placeholder": "Describe political position and jurisdiction",
              "fullWidth": true,
              "visibleWhen": {
                "field": "isPep",
                "equals": "yes"
              }
            }
          ],
          "modalSteps": [
            {
              "title": "Personal Details",
              "fields": [
                "name",
                "designation",
                "nationality",
                "dob"
              ]
            },
            {
              "title": "Identity Document",
              "fields": [
                "idType",
                "idNumber",
                "idExpiry",
                "countryOfResidence"
              ]
            },
            {
              "title": "Compliance",
              "fields": [
                "isPep",
                "pepDetails"
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Ultimate Beneficial Owner (UBO)",
      "columns": 2,
      "fields": [
        {
          "name": "uboName",
          "label": "UBO Full Legal Name",
          "type": "text",
          "placeholder": "As per passport / government-issued ID",
          "hint": "Person(s) owning or controlling \u2265 25% of the entity"
        },
        {
          "name": "uboNationality",
          "label": "UBO Nationality",
          "type": "select",
          "placeholder": "Select nationality\u2026",
          "dataSource": "/api/ref/nationalities"
        },
        {
          "name": "uboOwnershipPercent",
          "label": "Ownership / Control Percentage (%)",
          "type": "number",
          "placeholder": "e.g. 51",
          "hint": "Direct and/or indirect ownership percentage",
          "validations": {
            "min": {
              "value": 0,
              "message": "Must be 0 or greater"
            },
            "max": {
              "value": 100,
              "message": "Cannot exceed 100%"
            }
          }
        },
        {
          "name": "uboCountryOfResidence",
          "label": "UBO Country of Residence",
          "type": "select",
          "placeholder": "Select country\u2026",
          "dataSource": "/api/ref/countries"
        },
        {
          "name": "uboIdType",
          "label": "UBO ID Document Type",
          "type": "select",
          "placeholder": "Select ID type",
          "options": [
            {
              "label": "Passport",
              "value": "passport"
            },
            {
              "label": "National Identity Card",
              "value": "national_id"
            },
            {
              "label": "Driver's License",
              "value": "drivers_license"
            }
          ]
        },
        {
          "name": "uboIdNumber",
          "label": "UBO ID Document Number",
          "type": "text",
          "placeholder": "Document number"
        },
        {
          "name": "uboIsPep",
          "label": "Is the UBO a Politically Exposed Person (PEP)?",
          "type": "radio",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ]
        },
        {
          "name": "uboRelationshipToEntity",
          "label": "UBO Relationship to Entity",
          "type": "select",
          "placeholder": "Select relationship",
          "options": [
            {
              "label": "Shareholder / Equity Owner",
              "value": "shareholder"
            },
            {
              "label": "Beneficial Owner via Holding Company",
              "value": "holding_company"
            },
            {
              "label": "Trust Beneficiary",
              "value": "trust_beneficiary"
            },
            {
              "label": "Senior Managing Official",
              "value": "managing_official"
            }
          ]
        }
      ]
    }
  ]
}
